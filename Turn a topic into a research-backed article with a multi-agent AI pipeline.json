      ],
      "typeVersion": 1
    },
    {
      "parameters": {
        "content": "## 3. Log & deliver\nSplit out the title and meta, log the article to Sheets and email the finished piece.",
        "height": 652,
        "width": 660,
        "color": 7
      },
      "id": "ebc70786-204f-4f7e-8463-85dca1cd08c6",
