    },
    {
      "parameters": {
        "content": "## 2. Scrape and extract\nFetches the raw HTML of the page, then extracts the title, meta description, H1 headings and clean body text for the content audit.",
        "height": 520,
        "width": 420,
        "color": 7
      },
      "id": "69df5370-ecc7-4f5d-a3d1-b884aa2504a2",
